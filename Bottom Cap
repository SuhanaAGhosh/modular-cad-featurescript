FeatureScript 3029;
import(path : "onshape/std/common.fs", version : "3029.0");



annotation { "Feature Type Name" : "CanSat Bottom Cap" }
export const cansatBottomCap = defineFeature(function(context is Context, id is Id, definition is map)
    precondition
    {
    }
    {
        // ---- Bottom Cap: 3mm thick disc with camera + sensor holes ----
        const OD = 144 * millimeter;
        const capThickness = 3 * millimeter;

        const cameraDia = 10 * millimeter;
        const sensorDia = 20 * millimeter;
        const camToSensorDistance = 52 * millimeter; // center-to-center

        const sk = newSketchOnPlane(context, id + "bottomCapSk", {
            "sketchPlane" : plane(vector(0, 0, 0 * millimeter), vector(0, 0, 1), vector(1, 0, 0))
        });

        // Outer boundary
        skCircle(sk, "outer", {
            "center" : vector(0, 0) * millimeter,
            "radius" : OD / 2
        });

        // Camera hole - dead center (for ESP32/HiWonder module)
        skCircle(sk, "cameraHole", {
            "center" : vector(0, 0) * millimeter,
            "radius" : cameraDia / 2
        });

        // Sensor hole 1 - top (+Y), 52mm from camera center
        skCircle(sk, "sensorHoleTop", {
            "center" : vector(0, camToSensorDistance),
            "radius" : sensorDia / 2
        });

        // Sensor hole 2 - bottom (-Y), 52mm from camera center
        skCircle(sk, "sensorHoleBottom", {
            "center" : vector(0, -camToSensorDistance),
            "radius" : sensorDia / 2
        });

        skSolve(sk);

        const region = qSketchRegion(id + "bottomCapSk");

        opExtrude(context, id + "bottomCapExtrude", {
            "entities" : region,
            "direction" : vector(0, 0, 1) * meter,
            "endBound" : BoundingType.BLIND,
            "endDepth" : capThickness
        });

        setProperty(context, {
            "entities" : qCreatedBy(id + "bottomCapExtrude", EntityType.BODY),
            "propertyType" : PropertyType.NAME,
            "value" : "BottomCap"
        });
    });
